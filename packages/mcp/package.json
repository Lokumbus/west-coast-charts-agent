{
  "name": "@wcc-agent/mcp",
  "private": true,
  "version": "0.2.1",
  "description": "Official West Coast Charts MCP server: render, validate and describe charts headlessly (SVG/PNG + verification table), option schema slices and curated examples for AI agents.",
  "license": "MIT",
  "main": "src/index.js",
  "bin": {
    "wcc-mcp": "bin/wcc-mcp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "mcpName": "io.github.Lokumbus/west-coast-charts-agent",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "charts",
    "svg",
    "visualization",
    "west-coast-charts",
    "apexcharts-compatible"
  ],
  "scripts": {
    "start": "node bin/wcc-mcp.js",
    "start:http": "node bin/wcc-mcp.js --transport http",
    "test": "node --test test/",
    "server-card": "node scripts/server-card.js",
    "build:mcpb": "node scripts/build-mcpb.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@wcc-agent/render-core": "0.2.1",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
